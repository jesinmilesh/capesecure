# ==============================================================================
# Cape Secure Solutions — Production Environment Template
# NEVER commit real credentials, database keys, or API tokens.
# Configure production secrets in Vercel / Cloud Dashboard.
# ==============================================================================

NODE_ENV=production
PORT=3000

# Public Client Application URL
PUBLIC_URL=https://capesecure.vercel.app
PUBLIC_ORIGIN=https://capesecure.vercel.app

# Separate Admin Application URL (Protected Domain)
ADMIN_URL=https://admin.capesecure.vercel.app
ADMIN_ORIGIN=https://admin.capesecure.vercel.app

# Backend API Endpoint
API_URL=https://capesecure.vercel.app/api

# Authentication & Session Secrets (Must be 32+ char random strings in production)
JWT_SECRET=
SESSION_SECRET=

# Brevo Transactional Email & SMS Provider
BREVO_API_KEY=
BREVO_SENDER_NAME=Cape Secure Solutions
BREVO_SENDER_EMAIL=capesecuresolutions@gmail.com
ADMIN_EMAIL=capesecuresolutions@gmail.com
ADMIN_PHONE=

# Database Connection (MongoDB Atlas / PostgreSQL)
DATABASE_URL=
MONGODB_URI=
