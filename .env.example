# Cape Secure Solutions — Production Environment Template
# DO NOT COMMIT REAL CREDENTIALS. Configure real secrets in your deployment platform (Vercel / AWS / Docker).

# Database Configuration (Production MongoDB / Document Store)
MONGODB_URI=
DATABASE_URL=

# Cryptographic & Authentication Secrets
JWT_SECRET=
SESSION_SECRET=

# Brute-Force & Account Lockout Policy
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15

# Email & Notification Provider (Brevo / Transactional SMTP)
BREVO_API_KEY=
BREVO_SENDER_NAME=Cape Secure Solutions
BREVO_SENDER_EMAIL=
ADMIN_EMAIL=
ADMIN_PHONE=
WHATSAPP_NUMBER=

# Application & Origin URLs (CORS & Separation Enforcement)
PUBLIC_URL=https://capesecure.vercel.app
ADMIN_URL=https://admin.capesecure.vercel.app
CORS_ALLOWED_ORIGINS=https://capesecure.vercel.app,https://admin.capesecure.vercel.app

# Server Runtime
NODE_ENV=production
PORT=3000
